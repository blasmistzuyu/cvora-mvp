# Copiá este archivo como .env y completá los datos SOLO en tu computadora o Render.
# No lo subas a GitHub ni lo compartas.
OPENAI_API_KEY=
CVORA_ENABLE_AI=false
OPENAI_MODEL=gpt-5-mini
CVORA_GLOBAL_AI_LIMIT=20
CVORA_RATE_LIMIT=15

# Solo habilitar cobros con PostgreSQL persistente y cuenta Mercado Pago
CVORA_DEPLOYMENT=local
CVORA_ENABLE_PAYMENTS=false
CVORA_PRICE_ARS=4900
CVORA_PUBLIC_URL=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
DATABASE_URL=
